<!--
    Configuració de Logback: missatges per consola amb colors.
    - Canvia el nivell de root a "debug" per veure l'SQL que executa UtilsSQLite.
    - A doc/logback-consola-fitxer.xml hi ha una configuració que, a més,
      escriu el log a logs/app.log (copia-la aquí amb el nom logback.xml).
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %magenta([%thread]) %highlight(%-5level) %cyan(%logger{15}) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
